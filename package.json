    "eval:report": "node eval/summarize.mjs",
    "demo": "start-server-and-test dev http://localhost:5173 cy:demo",
    "cy:demo": "cypress run --spec cypress/e2e/demo.cy.ts"
  },
  "type": "module",
  "private": true,
  "dependencies": {
    "@google/genai": "^2.31.0",
