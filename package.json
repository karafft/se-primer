    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cypress": "^16.2.0",
    "start-server-and-test": "^3.0.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
